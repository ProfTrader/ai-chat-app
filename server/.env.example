# Dev-only fallback when no user session is connected
MOONSHOT_API_KEY=

# Default model for Kimi chat
MOONSHOT_MODEL=kimi-k2.6

# Local Ollama fallback. When set, this takes priority over Moonshot.
OLLAMA_MODEL=hermes-gemma4:e4b
OLLAMA_BASE_URL=http://localhost:11434
# Optional for Ollama Cloud or a remote Ollama-compatible endpoint.
# Use OLLAMA_BASE_URL=https://ollama.com for Ollama Cloud.
OLLAMA_API_KEY=

PORT=3001
